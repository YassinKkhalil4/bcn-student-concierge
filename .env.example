# ─── Public ──────────────────────────────────────────────────────────────
# Used to build Stripe return URLs. MUST be set explicitly: deriving it from
# the Host header would let an attacker redirect customers to a lookalike
# confirmation page after a real payment.
PUBLIC_ORIGIN=https://bcnstudentconcierge.com

# ─── Encryption ──────────────────────────────────────────────────────────
# Master key wrapping every per-document AES-256 key.
#   openssl rand -base64 32
# In production this belongs in a KMS/secret manager, never in a .env file
# committed anywhere. Rotating it requires re-wrapping existing DEKs — see
# docs/SECURITY.md.
DOCUMENT_MASTER_KEY=
DOCUMENT_KEY_VERSION=1

# ─── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` in development, or the endpoint's signing secret in the
# dashboard. Without it the webhook route refuses every request — which is the
# correct failure mode, since an unverified webhook lets anyone mark a case paid.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Storage & retention ─────────────────────────────────────────────────
DATA_DIR=./.data
FORM_TEMPLATE_DIR=./templates/forms
# Days after service completion before identity data is purged. 30 is the
# committed figure in the privacy notice; changing it means changing that too.
RETENTION_DAYS=30

# ─── Networking ──────────────────────────────────────────────────────────
# Set to "true" ONLY behind a proxy that appends (not passes through)
# x-forwarded-for. If a client can spoof that header, rate limiting is bypassed.
TRUST_PROXY=false
