# BCN Student Concierge — configuration.
#
# PRODUCTION (VPS): copy to `.env` next to docker-compose.yml and fill in. The
# file holds the master key: `chmod 600 .env`, owned by the deploy user, never
# committed, never copied into backups alongside the data it protects.
#
# LOCAL DEVELOPMENT: copy to `.env.local`. Leave DATABASE_URL empty to use the
# embedded Postgres under DATA_DIR.

# ─── Site ────────────────────────────────────────────────────────────────
# Used for Stripe return URLs. Set explicitly — never derived from the Host
# header, which a client controls.
PUBLIC_ORIGIN=https://bcnstudent.com

# ─── Deployment (docker-compose.yml) ─────────────────────────────────────
# Caddy runs on the host, not in Compose: the domain and the Let's Encrypt
# account email live in /etc/caddy/Caddyfile (see deploy/Caddyfile).
DOMAIN=bcnstudent.com
# Postgres password for the bundled database container.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ─── Database ────────────────────────────────────────────────────────────
# Set automatically by docker-compose.yml from POSTGRES_PASSWORD. Set it here
# only when running outside Docker or against another Postgres server.
# DATABASE_URL=postgres://bcn:PASSWORD@localhost:5432/bcn
DATABASE_POOL_MAX=10

# ─── Encryption ──────────────────────────────────────────────────────────
# Master key wrapping every per-record key: the intake questionnaire AND every
# uploaded document. Losing it makes all data unrecoverable; leaking it
# exposes all of it. Back it up somewhere separate from the database backups.
#   openssl rand -base64 32
DOCUMENT_MASTER_KEY=
DOCUMENT_KEY_VERSION=1

# ─── Document storage ────────────────────────────────────────────────────
# Default: the `documents` Docker volume, mounted at DATA_DIR=/data by
# docker-compose.yml. Outside Docker, set DATA_DIR to an absolute path on
# persistent disk — production refuses to start with a relative or unset path.
# DATA_DIR=/var/lib/bcnstudent
#
# Optional: S3-compatible object storage instead of the local volume.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SSE=
# S3_SSE_KMS_KEY_ID=

# ─── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
# Signing secret of the webhook endpoint https://bcnstudent.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Invoicing (facturas) ────────────────────────────────────────────────
# Printed on every invoice and frozen onto it at issue. Required in production.
# Autónomo: your full legal name. SL: the razón social.
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_TAX_ID=
INVOICE_ISSUER_ADDRESS="Carrer ..., 08000 Barcelona, España"

# ─── Staff dashboard (/admin) ────────────────────────────────────────────
# Both required, or /admin stays locked.
#   ADMIN_PASSWORD_HASH:  npm run admin:hash-password
#   ADMIN_SESSION_SECRET: openssl rand -base64 32   (rotate to sign everyone out)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ─── Student portal & email ──────────────────────────────────────────────
# Signs student sessions and one-time sign-in links.
#   openssl rand -base64 32   (rotate to sign every student out)
PORTAL_SESSION_SECRET=
# Transactional email (sign-in links, invoices) via Resend: https://resend.com
# Verify bcnstudent.com in Resend — choose the EU region (eu-west-1) — and add
# the SPF/DKIM DNS records it shows. Without a key, development prints emails
# to the console; production refuses to start.
RESEND_API_KEY=
EMAIL_FROM="BCN Student Concierge <hello@bcnstudent.com>"

# ─── Staff alerts (Telegram) ─────────────────────────────────────────────
# Optional. Sends "🔔 New Client" on each payment and "📄 Docs Uploaded" when a
# student submits for review. References and amounts only — never names.
# Set both or neither (half-configured refuses to start). See docs/DEPLOY.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Translations (development only) ────────────────────────────────────
# DeepL API key for `npm run i18n:translate`. Put it in .env.local on the
# machine that updates translations — NEVER on the server: the translated
# catalogues are committed and the site never calls DeepL at runtime.
# DEEPL_API_KEY=

# ─── Retention & background jobs ─────────────────────────────────────────
# Identity data and documents are deleted this many days after a case is marked
# completed. 30 is the figure in the privacy notice — change both together.
RETENTION_DAYS=30
# The server runs retention itself on this interval (default on in production).
MAINTENANCE_INTERVAL_MINUTES=60
# MAINTENANCE_ENABLED=true
# MIGRATE_ON_START=true

# ─── Forms ───────────────────────────────────────────────────────────────
FORM_TEMPLATE_DIR=./templates/forms
