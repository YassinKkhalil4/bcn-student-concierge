# ─── Public ──────────────────────────────────────────────────────────────
# Used to build Stripe return URLs. MUST be set explicitly: deriving it from
# the Host header would let an attacker redirect customers to a lookalike
# confirmation page after a real payment.
PUBLIC_ORIGIN=https://bcnstudentconcierge.com

# ─── Encryption ──────────────────────────────────────────────────────────
# Master key wrapping every per-document AES-256 key.
#   openssl rand -base64 32
# In production this belongs in a KMS/secret manager, never in a .env file
# committed anywhere. Rotating it requires re-wrapping existing DEKs — see
# docs/SECURITY.md.
DOCUMENT_MASTER_KEY=
DOCUMENT_KEY_VERSION=1

# ─── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` in development, or the endpoint's signing secret in the
# dashboard. Without it the webhook route refuses every request — which is the
# correct failure mode, since an unverified webhook lets anyone mark a case paid.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Object storage (document bodies) ────────────────────────────────────
# Encrypted document bodies go here. REQUIRED in production — the app refuses
# to store identity documents on local disk when NODE_ENV=production, because
# on serverless that silently loses every upload at the next deploy.
#
# AWS S3:
#   S3_BUCKET=bcn-documents
#   S3_REGION=eu-west-1
#   S3_SSE=aws:kms
#   S3_SSE_KMS_KEY_ID=arn:aws:kms:eu-west-1:...
#   (credentials via IAM role — leave the key vars unset)
#
# Cloudflare R2:
#   S3_BUCKET=bcn-documents
#   S3_REGION=auto
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#   (do NOT set S3_SSE — R2 encrypts at rest unconditionally and rejects the header)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=
S3_SSE_KMS_KEY_ID=

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────
# Required in production. Without it the limiter fails OPEN and logs an error —
# rate limiting is abuse protection, not authentication, so an Upstash outage
# must not take down the intake portal.
# Create at https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Metadata store & retention ──────────────────────────────────────────
# Case metadata (still local JSON — replace with Postgres before scaling out).
DATA_DIR=./.data
FORM_TEMPLATE_DIR=./templates/forms
# Days after service completion before identity data is purged. 30 is the
# committed figure in the privacy notice; changing it means changing that too.
RETENTION_DAYS=30

# ─── Networking ──────────────────────────────────────────────────────────
# Set to "true" ONLY behind a proxy that appends (not passes through)
# x-forwarded-for. If a client can spoof that header, rate limiting is bypassed.
TRUST_PROXY=false
