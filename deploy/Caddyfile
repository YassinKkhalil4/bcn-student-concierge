# Reverse proxy and TLS termination for BCN Student Concierge.
#
# This runs on the HOST, not in a container: Caddy on this machine already
# fronts other sites. Install it as a site block — either append this to
# /etc/caddy/Caddyfile or drop it in as its own file and import it:
#
#   sudo cp deploy/Caddyfile /etc/caddy/sites/bcnstudent.caddy
#   # in /etc/caddy/Caddyfile:  import sites/*.caddy
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Certificates are obtained and renewed automatically from Let's Encrypt; set
# the account email once, globally, in /etc/caddy/Caddyfile:
#
#   { email you@example.com }

bcnstudent.com, www.bcnstudent.com {
	# One canonical host: www redirects to the apex.
	@www host www.bcnstudent.com
	redir @www https://bcnstudent.com{uri} permanent

	# TLS 1.3 only. TLS 1.2 and older are refused outright. Every browser from
	# roughly 2018 onward supports 1.3; the trade is a handful of very old
	# clients in exchange for no downgrade surface at all.
	tls {
		protocols tls1.3
	}

	encode zstd gzip

	# Uploads are capped at 10 MB in the app; allow multipart overhead on top.
	request_body {
		max_size 12MB
	}

	# The site is proxied by Cloudflare, so the connection Caddy sees comes from
	# a Cloudflare edge server, not from the student. Using that address would
	# put every visitor behind the same few IPs and one shared rate limit. For
	# connections that really come from Cloudflare's published ranges
	# (https://www.cloudflare.com/ips/ — re-check when Cloudflare changes them),
	# the student's address is the CF-Connecting-IP header Cloudflare sets.
	# Anyone reaching the server directly cannot forge it: their connection is
	# not from a Cloudflare range, so their own socket address is used.
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	# The container publishes only on loopback (docker-compose.yml).
	# X-Real-IP is OVERWRITTEN, never appended: the app's rate limiter keys on
	# it, so a value a client sent must never survive to reach it.
	handle @cloudflare {
		reverse_proxy 127.0.0.1:3005 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up -X-Forwarded-For
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3005 {
			header_up X-Real-IP {remote_host}
			header_up -X-Forwarded-For
		}
	}
}
